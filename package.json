{
  "name": "ai-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Unified AI agent platform combining CLI and Web interfaces",
  "type": "module",
  "scripts": {
    "dev:cli": "pnpm --filter @ai-harness/cli dev",
    "dev:web": "pnpm --filter @ai-harness/web dev",
    "dev": "concurrently \"pnpm dev:cli\" \"pnpm dev:web\"",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules dist .turbo"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
