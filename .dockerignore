# .dockerignore - Fichiers exclus du contexte de build Docker

# Dépendances (sont réinstallées dans le conteneur)
node_modules/
**/node_modules/

# Build outputs
dist/
.turbo/

# Test coverage
coverage/
*.lcov

# IDE et éditeurs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# E2E test reports
playwright-report/
test-results/

# Fichiers de configuration Docker (non nécessaires dans le contexte)
.docker/
Dockerfile*
docker-compose*
Makefile

# Documentation et autres
docs/
*.md
LICENSE
CHANGELOG.md

# Scripts internes non nécessaires au build
scripts/
