# .dockerignore - Fichiers exclus du contexte de build Docker

# Dépendances (sont réinstallées dans le conteneur)
node_modules/
**/node_modules/

# Build outputs
dist/
.turbo/

# Test coverage
coverage/
*.lcov

# IDE et éditeurs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# E2E test reports
playwright-report/
test-results/

# Fichiers de configuration Docker (non nécessaires dans le contexte)
.docker/*
# Required by the test image's E2E entry point and build-time packaging controls.
!.docker/Dockerfile.test
!.docker/e2e-suites.mjs
!.docker/e2e-suites.d.mts
!.docker/e2e-suites.test.mjs
!.docker/test-build.test.mjs
!.docker/baseline-artifacts.mjs
!.docker/baseline-artifacts.test.mjs
!.docker/run-e2e.mjs
!.docker/test-fonts.conf
!.docker/test-fonts.test.mjs
Dockerfile*
docker-compose*
Makefile

# Documentation et autres
docs/
*.md
LICENSE
CHANGELOG.md

# Scripts internes non nécessaires au build
scripts/
