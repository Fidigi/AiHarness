{
  "name": "@ai-harness/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-harness": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
