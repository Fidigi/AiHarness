    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-harness/core": "workspace:*",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
