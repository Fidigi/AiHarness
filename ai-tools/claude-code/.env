# ─────────────────────────────────────
# Claude Code conteneur - configuration
# ─────────────────────────────────────

# Git (auteur des commits depuis le conteneur)
GIT_USER_NAME=Fidigi
GIT_USER_EMAIL=fidigi@gmail.com

# WSL User
WSL_UID=1000
WSL_GID=1000

# Group ID du groupe "docker" sur la machine hôte
# Récupérer avec : getent group docker | cut -d: -f3
DOCKER_GID=989

# Modèle LLM
ANTHROPIC_MODEL=qwen3.6-35b-a3b

# Accès au modèle (Ollama via OpenAI-compatible endpoint)
ANTHROPIC_BASE_URL=http://127.0.0.1:8888
ANTHROPIC_AUTH_TOKEN=lama-cpp

# Claude Code
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Environnement Node
NODE_ENV=development
